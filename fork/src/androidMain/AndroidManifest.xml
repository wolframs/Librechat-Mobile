<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- The app's launcher entries, one per icon. Exactly one is enabled at a time
             (LauncherIconSwitcher); MainActivity itself carries no LAUNCHER category. The names are
             what a launcher stores for a home-screen icon: renaming one drops that icon. -->
        <activity-alias
            android:name="com.garfiec.librechat.fork.icon.ColdLab"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/fork_launcher_cold_lab"
            android:roundIcon="@mipmap/fork_launcher_cold_lab"
            android:targetActivity="com.garfiec.librechat.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="com.garfiec.librechat.fork.icon.NightGlass"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/fork_launcher_night_glass"
            android:roundIcon="@mipmap/fork_launcher_night_glass"
            android:targetActivity="com.garfiec.librechat.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="com.garfiec.librechat.fork.icon.EmberAlchemy"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/fork_launcher_ember_alchemy"
            android:roundIcon="@mipmap/fork_launcher_ember_alchemy"
            android:targetActivity="com.garfiec.librechat.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
